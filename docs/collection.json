                        {
                            "name": "Listar y filtrar clientes.",
                            "request": {
                                "url": {
                                    "host": "{{baseUrl}}",
                                    "path": "api\/v1\/customers",
                                    "query": [
                                        {
                                            "key": "search",
                                            "value": "architecto",
                                            "description": "Busca por nombre legal, nombre comercial, correo, tel\u00e9fono, NIT o NRC.",
                                            "disabled": false
                                        },
                                        {
                                            "key": "status",
                                            "value": "active",
                                            "description": "Filtrar por estado.",
                                            "disabled": false
                                        },
                                        {
                                            "key": "phone",
                                            "value": "architecto",
                                            "description": "Filtrar por tel\u00e9fono (coincidencia parcial).",
                                            "disabled": false
                                        },
                                        {
                                            "key": "desde",
                                            "value": "architecto",
                                            "description": "date Filtrar por fecha de creaci\u00f3n desde (YYYY-MM-DD).",
                                            "disabled": false
                                        },
                                        {
                                            "key": "hasta",
                                            "value": "architecto",
                                            "description": "date Filtrar por fecha de creaci\u00f3n hasta (YYYY-MM-DD).",
                                            "disabled": false
                                        },
                                        {
                                            "key": "limit",
                                            "value": "15",
                                            "description": "Cantidad de resultados por p\u00e1gina.",
                                            "disabled": false
                                        }
                                    ],
                                    "raw": "{{baseUrl}}\/api\/v1\/customers?search=architecto&status=active&phone=architecto&desde=architecto&hasta=architecto&limit=15"
                                },
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Content-Type",
                                        "value": "application\/json"
                                    },
                                    {
                                        "key": "Accept",
                                        "value": "application\/json"
                                    }
                                ],
                                "body": null,
                                "description": "Obtiene una lista paginada de clientes con opciones de b\u00fasqueda y filtros."
                            },
                            "response": [
                                {
                                    "header": [],
                                    "code": 200,
                                    "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"legalName\": \"Cliente Ejemplo S.A. de C.V.\",\n      \"tradeName\": \"Cliente Ejemplo\",\n      \"taxId\": \"0614-260290-101-1\",\n      \"nrc\": \"123456-7\",\n      \"phone\": \"7000-0000\",\n      \"status\": \"active\",\n      \"currentPlanName\": \"Plan B\u00e1sico\",\n      \"cashBalance\": 250.5,\n      \"loyaltyPoints\": 120,\n      \"createdAt\": \"2026-09-23T06:00:00+00:00\"\n    }\n  ],\n  \"links\": {\n    \"first\": \"http:\/\/localhost\/api\/v1\/customers?page=1\",\n    \"last\": \"http:\/\/localhost\/api\/v1\/customers?page=1\",\n    \"prev\": null,\n    \"next\": null\n  },\n  \"meta\": {\n    \"current_page\": 1,\n    \"from\": 1,\n    \"last_page\": 1,\n    \"path\": \"http:\/\/localhost\/api\/v1\/customers\",\n    \"per_page\": 15,\n    \"to\": 1,\n    \"total\": 1\n  }\n}",
                                    "name": ""
