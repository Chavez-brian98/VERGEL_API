                  "const json = pm.response.json();",
                  "",
                  "pm.test('Reporte de ventas', function () {",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json.meta.summary).to.have.property('totalSales');",
                  "  pm.expect(json.meta.summary).to.have.property('totalPaid');",
                  "  pm.expect(json.meta.summary).to.have.property('averageTicket');",
                  "  if (json.data.length > 0) {",
                  "    pm.expect(json.data[0]).to.have.property('period');",
                  "    pm.expect(json.data[0]).to.have.property('totalPending');",
                  "  }",
                  "});"
